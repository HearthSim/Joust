{
	"name": "joust",
	"description": "Hearthstone replays in your browser",
	"bugs": {
		"url": "https://github.com/HearthSim/Joust/issues"
	},
	"license": "UNLICENSED",
	"author": "Benedict Etzel <benedict@hearthsim.net>",
	"main": "main.js",
	"repository": {
		"type": "git",
		"url": "https://github.com/HearthSim/Joust.git"
	},
	"scripts": {
		"build": "gulp compile:web",
		"dev": "concurrently 'gulp watch:html watch:assets watch:styles' 'webpack --watch -d'",
		"test": "vitest run",
		"typecheck": "tsc --noEmit --skipLibCheck",
		"postinstall": "gulp enums:download",
		"lint": "pnpm lint:prettier",
		"lint:prettier": "prettier -l \"*.{js,json}\" \"src/**/*.{ts,tsx,js}\"",
		"format": "pnpm format:prettier",
		"format:prettier": "prettier --write \"*.{js,json}\" \"src/**/*.{ts,tsx,js}\""
	},
	"dependencies": {
		"@electron/remote": "^2",
		"@types/cookiejs": "^1.0.30",
		"@types/lodash": "^4.14.58",
		"@types/node": "^14.18.58",
		"@types/react": "^16.0.38",
		"@types/react-dom": "^16.0.4",
		"@types/sax": "^1.0.0",
		"autoprefixer": "^7.1.2",
		"babel-core": "^6.24.0",
		"babel-loader": "^7.1.2",
		"babel-preset-es2015": "^6.24.0",
		"babel-preset-react": "^6.23.0",
		"bowser": "^1.6.0",
		"cookie_js": "^1.2.2",
		"cssnano": "^3.10.0",
		"electron": "^14",
		"filereader-stream": "^1.0.0",
		"git-describe": "^4.0.1",
		"gulp": "^4.0.2",
		"gulp-download": "0.0.1",
		"gulp-file": "^0.4.0",
		"gulp-filter": "^5.0.0",
		"gulp-less": "^3.3.0",
		"gulp-livereload": "^3.8.1",
		"gulp-plumber": "^1.1.0",
		"gulp-postcss": "^7.0.0",
		"gulp-sourcemaps": "^2.4.1",
		"gulp-util": "^3.0.8",
		"hearthstonejson-client": "^1.16.0",
		"immutable": "^3.8.1",
		"lodash": "^4.17.4",
		"react": "^16.2.0",
		"react-dom": "^16.2.0",
		"sax": "^1.2.2",
		"through2": "^2.0.3",
		"ts-loader": "^3.5.0",
		"typescript": "~6.0",
		"webpack": "^3.5.5",
		"webpack-stream": "^4.0.0",
		"websocket-stream": "^5.0.1"
	},
	"devDependencies": {
		"@semantic-release/exec": "^7.1.0",
		"concurrently": "^3.5.1",
		"conventional-changelog-conventionalcommits": "^9.3.1",
		"prettier": "^1.13.2",
		"semantic-release": "^25.0.9",
		"vitest": "^3.2.4"
	},
	"prettier": {
		"useTabs": true,
		"arrowParens": "always",
		"trailingComma": "all"
	},
	"release": {
		"branches": [
			"main"
		],
		"tagFormat": "v${version}",
		"plugins": [
			[
				"@semantic-release/commit-analyzer",
				{
					"preset": "conventionalcommits"
				}
			],
			[
				"@semantic-release/exec",
				{
					"successCmd": "echo \"version=${nextRelease.version}\" >> \"$GITHUB_OUTPUT\""
				}
			]
		]
	},
	"private": true,
	"packageManager": "pnpm@12.11.2+sha512.25a51652a196785af5f28bda6dfe8dc582ebefa4ac1d180221ce1390231c5fb76637822ea4b6e4633ce74acdcb0a77f725af11bad38177fdeddaee818a955cb9"
}
