{
	"compilerOptions": {
		"declaration": false,
		"jsx": "react",
		"moduleResolution": "node",
		"strict": true,
		"noImplicitAny": false,
		"strictNullChecks": false,
		"strictPropertyInitialization": false,
		"noLib": false,
		"removeComments": true,
		"sourceMap": true,
		"allowSyntheticDefaultImports": true,
		"target": "es6"
	}
}
